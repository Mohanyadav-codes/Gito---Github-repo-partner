# Gito Environment Configuration

# Choose your LLM provider: Groq (ultra-fast, free tier available) or OpenAI
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional model override (defaults: Groq -> llama-3.3-70b-versatile, OpenAI -> gpt-4o-mini)
# GITO_MODEL=llama-3.3-70b-versatile

# Optional local/custom endpoint (e.g., Ollama or vLLM)
# OPENAI_BASE_URL=http://localhost:11434/v1

# Qdrant Configuration (Defaults to embedded local disk at ./qdrant_db)
# QDRANT_PATH=./qdrant_db
# QDRANT_URL=
# QDRANT_API_KEY=
